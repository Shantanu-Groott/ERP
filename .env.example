APP_NAME="Kalavanta Edutech ERP"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8001
APP_KEY=base64_erp_random_secret_key_32chars_long_12345

# ====================================================
# DATABASE TARGET: 'local' (Tests) or 'remote' (Deployment)
# ====================================================
DB_TARGET=local

# ----------------------------------------------------
# 1. LOCAL TEST DATABASE (Database: erp, User: root)
# ----------------------------------------------------
DB_LOCAL_DRIVER=mysql
DB_LOCAL_HOST=127.0.0.1
DB_LOCAL_PORT=3306
DB_LOCAL_NAME=erp
DB_LOCAL_USER=root
DB_LOCAL_PASS=your_local_root_password

# ----------------------------------------------------
# 2. REMOTE DEPLOYMENT DATABASE (Production / Remote)
# ----------------------------------------------------
EDULMS_STUDENT_DB_DRIVER=mysql
EDULMS_STUDENT_DB_HOST=localhost
EDULMS_STUDENT_DB_PORT=3306
EDULMS_STUDENT_DB_NAME=groott_o1_student
EDULMS_STUDENT_DB_USER=your_remote_db_user
EDULMS_STUDENT_DB_PASS=your_remote_db_password

# Legacy fallbacks
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=erp
DB_USERNAME=root
DB_PASSWORD=your_local_root_password

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@erp.local"
MAIL_FROM_NAME="${APP_NAME}"

SESSION_LIFETIME=120
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
